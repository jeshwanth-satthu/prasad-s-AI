# Google Gemini API key. Leave blank to run in Demo Mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# MongoDB connection string (e.g. from a Supabase/Atlas/local instance).
# Leave blank to run without persistence (Demo Mode).
MONGODB_URI=

# YouTube Data API key, for future channel/comment integration.
YOUTUBE_API_KEY=

# Comma-separated list of origins allowed to call this API.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
